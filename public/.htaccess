# Serve hashed build assets with the correct MIME type. Without these, some shared
# hosts fall back to text/html and strict module checking rejects the script.
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/javascript .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType application/pdf .pdf
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite real files or directories — this is what keeps /assets/*.js from
  # being swallowed by the SPA fallback below.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Anything that looks like a build asset must 404 rather than return index.html,
  # so a bad deploy surfaces as a missing file instead of a confusing MIME error.
  RewriteRule ^assets/ - [L,R=404]

  # Client-side routing: everything else renders the SPA shell.
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed filenames change on every build, so they are safe to cache indefinitely.
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  # The shell and content JSON must stay fresh.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
